// 说明：本文件是配置样例，复制为 .env 后填写。所有键以 R4P_ 开头。

# ── 数据目录（SQLite 库、上传原件、日志都在这里） ─────────────
R4P_DATA_DIR=data

# ── 向量化模型（任意 OpenAI 兼容 /embeddings 服务；此处为 ModelScope） ──
R4P_EMBEDDING_BASE_URL=https://api-inference.modelscope.cn/v1
R4P_EMBEDDING_API_KEY=sk-请替换
R4P_EMBEDDING_MODEL=iic/nlp_gte_sentence-embedding_chinese-base
# 留 0 表示首次调用时自动探测维度并写入数据库；换模型后必须 reindex。
# 用 Milvus 后端时建议显式填写（gte-base-chinese 为 768），否则首启会先退化到 numpy。
R4P_EMBEDDING_DIM=0

# ── 大模型（同样是 OpenAI 兼容；示例为 ModelScope 上的 Qwen3） ──
R4P_LLM_BASE_URL=https://api-inference.modelscope.cn/v1
R4P_LLM_API_KEY=sk-请替换
R4P_LLM_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
R4P_LLM_TEMPERATURE=0.2
R4P_LLM_MAX_TOKENS=2048

# ── 检索参数 ────────────────────────────────────────────
R4P_RECALL_K=50
R4P_TOP_K=8
R4P_CHUNK_MAX_TOKENS=480
R4P_CHUNK_MIN_TOKENS=80
# 远程重排（可选）：留空即不重排。示例为 SiliconFlow 的 bge-reranker
R4P_RERANK_URL=
R4P_RERANK_API_KEY=
R4P_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ── 向量后端 ─────────────────────────────────────────────
# milvus：Milvus Lite（Windows 不可用）或 standalone；numpy：零依赖精确检索
R4P_VECTOR_BACKEND=milvus
R4P_MILVUS_URI=data/vectors.db
R4P_MILVUS_COLLECTION=chunks_vec
